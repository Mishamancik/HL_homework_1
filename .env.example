# Grafana credentials for personal viewing and dashboard generator
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Configure load generation (total across both app instances)
TARGET_RPS=40
RAMP_DURATION=3m
ERROR_404_RATE=0.05
ERROR_409_RATE=0.04
ERROR_400_RATE=0.03
FAULT_500_RATE=0.02
LATENCY_JITTER_MS=2
LATENCY_TAIL_RATE=0.08
LATENCY_TAIL_MS=40
LOAD_WORKERS=32
